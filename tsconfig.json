{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2024",
   /* Modules */
    "module": "ES2022",
    // "rootDir": "./",
     "lib": ["ES2024"],
    "moduleResolution": "node",
    "types": ["bun-types"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@services/*": [
        "./src/services/*"
      ],
      "@shared-types/*": [
        "./src/types/*"
      ],
      "@schemas/*" : [
        "./src/schemas/*"
      ],
      "@plugins/*": [
        "./src/plugins/*"
      ],
      "@common/*": [
        "./src/common/*"
      ],
      "@prisma/client": [
        "./prisma-client"
      ],
      "@intefaces/*": [
        "./src/intefaces/*"
      ]
    }
  }
}
