{
  "name": "holder-backend",
  "version": "1.0.50",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun run --watch src/index.ts",
    "bot:start": "bun run --watch modules/bot/index.ts",
    "prisma:generate": "bunx prisma generate",
    "prisma:push": "bunx prisma db push --force-reset",
    "migrate:auth": "bun run modules/auth/migrations/user.ts",
    "migrate:project": "bun run modules/project/migrations/project_seed.ts && bun run modules/project/migrations/project_settings.ts",
    "migrate:all": "bun run migrate:auth && bun run migrate:project",
    "gpm": "bun run prisma:generate && bun run prisma:push && bun run migrate:all"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/jwt": "^1.4.0",
    "@elysiajs/swagger": "^1.3.1",
    "@prisma/client": "^6.19.0",
    "elysia": "latest",
    "grammy": "^1.39.3",
    "grammy-scenes": "^10.2.0",
    "prisma": "^6.19.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "bun-types": "latest"
  }
}
