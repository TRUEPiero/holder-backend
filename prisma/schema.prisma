generator client {
  provider      = "prisma-client-js"
  output        = "../prisma-client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  // provider = "postgresql"
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  demo
}

enum TransactionType {
  income
  expense
}

enum ProjectRole {
  viewer
  editor
}

enum SettingType {
  enum
  string
  number
  boolean
  float
}

model User {
  id       Int      @id @default(autoincrement())
  name     String
  password String
  role     UserRole @default(demo)
  email    String   @unique

  telegram   String? @unique
  telegramId Int?    @unique @map("telegram_id")

  OwnedProjects Project[]           @relation("ProjectOwner")
  projects      ProjectMember[]
  transactions  Transaction[]

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  @@index([name, email])
  @@map("users")
}

model registerVerify {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  expiredAt DateTime
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("register_verify")
}

model Project {
  id    Int    @id @default(autoincrement())
  title String

  settings Json?

  ownerId Int  @map("owner_id")
  owner   User @relation(name: "ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  cashboxes Cashbox[]
  members   ProjectMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([id, ownerId])
  @@map("projects")
}

model SettingGroup {
  id              Int              @id @default(autoincrement())
  code            String
  title           String
  description     String

  projectSettings ProjectSetting[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("setting_group")
}

model ProjectSetting {
  id          Int         @id @default(autoincrement())
  code        String      @unique
  type        SettingType
  values      Json?
  value       Json?
  title       String
  description String?
  isDisable   Boolean     @default(false)
  isRequired  Boolean     @default(false)

  groupId Int
  group   SettingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("project_setting")
}

model ProjectInvite {
  id        Int    @id @default(autoincrement())
  email     String
  code      String
  projectId Int    @map("project_id")

  expiredAt DateTime
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("project_invite")
}

model ProjectMember {
  id        Int @id @default(autoincrement())
  projectId Int @map("project_id")
  userId    Int @map("user_id")

  role ProjectRole

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  joinedAt  DateTime @default(now())
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([projectId, userId])
  @@index([id, projectId, userId])
  @@map("project_member")
}

model Cashbox {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  balance     Decimal @default(0)

  parameters Json?

  projectId Int     @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  linkAsParent CashboxLink[] @relation("parent")
  linkAsChild  CashboxLink[] @relation("children")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([id, projectId])
  @@map("cashbox")
}

model CashboxLink {
  id Int @id @default(autoincrement())

  parentId   Int
  childrenId Int

  parent   Cashbox @relation(fields: [parentId], references: [id], onDelete: Cascade, name: "parent")
  children Cashbox @relation(fields: [childrenId], references: [id], onDelete: Cascade, name: "children")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, childrenId])
  @@map("cashbox_link")
}

model Transaction {
  id          Int     @id @default(autoincrement())
  amount      Decimal
  description String?

  type TransactionType

  tags TransactionTag[]

  authorId Int  @map("author_id")
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  cashboxId Int     @map("cashbox_id")
  cashbox   Cashbox @relation(fields: [cashboxId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([id])
  @@map("transaction")
}

model TransactionTag {
  id    Int    @id @default(autoincrement())
  title String

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transaction_tag")
}

model ProjectField {
  id    Int    @id @default(autoincrement())
  title String

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model CashboxField {
  id    Int    @id @default(autoincrement())
  title String

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}