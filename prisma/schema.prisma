generator client {
  provider      = "prisma-client-js"
  output        = "../prisma-client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  // provider = "postgresql"
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  demo
}

enum TransactionType {
  income
  expense
}

enum ProjectRole {
  owner
  viewer
  editor
}

enum SettingType {
  enum
  string
  number
  boolean
}

model User {
  id       Int      @id @default(autoincrement())
  name     String
  password String
  role     UserRole @default(demo)
  email    String   @unique

  telegram   String? @unique
  telegramId Int?    @unique

  OwnedProjects Project[]           @relation("ProjectOwner")
  projects      ProjectMembership[]
  transactions  Transaction[]

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  @@index([name, email])
  @@map("users")
}

model registerVerify {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  expiredAt DateTime
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("auth_register_verify")
}

model Project {
  id      Int     @id @default(autoincrement())
  title   String
  default Boolean @default(false)

  settings Json?

  ownerId Int  @map("owner_id")
  owner   User @relation(name: "ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  cashboxes Cashbox[]
  members   ProjectMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([id, ownerId])
  @@map("pr_projects")
}

model SettingGroup {
  id              Int              @id @default(autoincrement())
  code            String
  title           String
  description     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  projectSettings ProjectSetting[]
}

model ProjectSetting {
  id          Int            @id @default(autoincrement())
  name        String
  code        String         @unique
  description String?
  disable     Boolean        @default(false)
  type        SettingType
  groupId     Int
  group       SettingGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  values      SettingValue[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model SettingValue {
  id Int @id @default(autoincrement())

  valueString  String?  @map("value_string")
  valueInteger Int?     @map("value_integer")
  valueFloat   Float?   @map("value_float")
  valueBoolean Boolean? @map("value_boolean")

  settingId Int
  setting   ProjectSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectInvite {
  id        Int    @id @default(autoincrement())
  email     String
  code      String
  projectId Int    @map("project_id")

  expiredAt DateTime
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("project_invite")
}

model ProjectMembership {
  id        Int @id @default(autoincrement())
  projectId Int @map("project_id")
  userId    Int @map("user_id")

  role ProjectRole

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([id, projectId, userId])
  @@map("project_membership")
}

model Cashbox {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  balance     Int     @default(0)

  parameters Json?

  projectId Int @map("project_id")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  linkAsParent CashboxLink[] @relation("parent")
  linkAsChild  CashboxLink[] @relation("children")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([id, projectId])
  @@map("project_cashbox")
}

model CashboxLink {
  id Int @id @default(autoincrement())

  parentId   Int
  childrenId Int

  parent   Cashbox @relation(fields: [parentId], references: [id], onDelete: Cascade, name: "parent")
  children Cashbox @relation(fields: [childrenId], references: [id], onDelete: Cascade, name: "children")

  @@unique([parentId, childrenId])
  @@map("pr_cashbox_link ")
}

model Transaction {
  id          Int     @id @default(autoincrement())
  amount      Decimal
  description String?

  type TransactionType

  tags TransactionTag[]

  authorId Int  @map("author_id")
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  cashboxId Int     @map("cashbox_id")
  cashbox   Cashbox @relation(fields: [cashboxId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([id])
  @@map("prpject_transaction")
}

model TransactionTag {
  id    Int    @id @default(autoincrement())
  title String

  transactions Transaction[]
}
