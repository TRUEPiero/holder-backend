generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  trial
  personal
  enterprise
}

enum MemberRole {
  viewer
  editor
}

enum SettingType {
  enum
  string
  number
  boolean
  float
}

enum SettingTarget {
  project
  cashbox
}

enum TransactionType {
  income
  expense
}

model User {
  id       Int        @id @default(autoincrement())
  name     String
  password String
  status   UserStatus @default(trial)
  email    String     @unique

  telegram   String? @unique
  telegramId Int?    @unique @map("telegram_id")

  OwnedProjects Project[]       @relation("ProjectOwner")
  projects      ProjectMember[]
  transactions  Transaction[]

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  @@index([name, email])
  @@map("user")
}

model registerVerify {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  expiredAt DateTime

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("register_verify")
}

model Project {
  id    Int    @id @default(autoincrement())
  title String

  settings Json?

  ownerId Int  @map("owner_id")
  owner   User @relation(name: "ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  cashboxes Cashbox[]
  members   ProjectMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([id, ownerId])
  @@map("project")
}

model ProjectField {
  id    Int    @id @default(autoincrement())
  title String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectMember {
  id        Int @id @default(autoincrement())
  projectId Int @map("project_id")
  userId    Int @map("user_id")

  role MemberRole

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([id, projectId, userId])
  @@map("project_member")
}

model ProjectInvite {
  id        Int    @id @default(autoincrement())
  email     String
  code      String
  projectId Int    @map("project_id")

  expiredAt DateTime

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("project_invite")
}

model Cashbox {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  balance     Decimal @default(0)

  settings Json? @default("[]")

  projectId Int     @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([id, projectId])
  @@map("cashbox")
}

model CashboxField {
  id    Int    @id @default(autoincrement())
  title String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id          Int     @id @default(autoincrement())
  amount      Decimal
  description String?

  type TransactionType

  tags TransactionTag[]

  isDeleted Boolean @default(false)

  authorId Int  @map("author_id")
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  cashboxId Int     @map("cashbox_id")
  cashbox   Cashbox @relation(fields: [cashboxId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([id])
  @@map("transaction")
}

model TransactionTag {
  id    Int    @id @default(autoincrement())
  title String 

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transaction_tag")
}

model SettingGroup {
  id          Int    @id @default(autoincrement())
  code        String
  title       String
  description String

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  settingDefinitions SettingDefinition[]

  @@map("setting_group")
}

model SettingDefinition {
  id   Int         @id @default(autoincrement())
  code String      @unique
  type SettingType

  title       String
  description String?

  values Json?
  value  Json?

  target SettingTarget

  isRequired Boolean @default(false)
  isDisabled Boolean @default(false)
  isTelegram Boolean @default(false)

  groupId Int?
  group   SettingGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("setting")
}