generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  trial
  personal
  enterprise
}

enum SettingType {
  enum
  string
  number
  boolean
  float
}

enum SettingTarget {
  project
  cashbox
}

enum TransactionType {
  income
  expense
}

enum PermissionsEntity {
  project
  cashbox
  transaction
  member
  settings
  budget
}

enum PermissionSetting {
  create
  read
  update
  delete
  invite
}

model User {
  id       Int        @id @default(autoincrement())
  name     String
  password String
  status   UserStatus @default(trial)
  email    String     @unique

  telegram   String? @unique
  telegramId String?    @unique @map("telegram_id")

  OwnedProjects Project[]       @relation("ProjectOwner")
  projects      ProjectMember[]
  transactions  Transaction[]

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  @@index([name, email])
  @@map("user")
}

model RegisterVerify {
  id        Int      @id @default(autoincrement())
  email     String
  code      String

  isChecked Boolean  @default(false)

  verifyToken String? @unique
  
  expiredAt DateTime

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("register_verify")
}

model Project {
  id    Int    @id @default(autoincrement())
  title String

  settings ProjectSettings[]

  ownerId Int  @map("owner_id")
  owner   User @relation(name: "ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  cashboxes Cashbox[]
  members   ProjectMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([id, ownerId])
  @@map("project")
}

model ProjectField {
  id    Int    @id @default(autoincrement())
  title String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectMember {
  id        Int @id @default(autoincrement())
  projectId Int @map("project_id")
  userId    Int @map("user_id")

  roleId Int
  role MemberRole @relation(fields: [roleId], references: [id])

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([id, projectId, userId])
  @@map("project_member")
}

model MemberRole {
  id        Int @id @default(autoincrement())
  name String @unique

  isDefault Boolean @default(false)

  member ProjectMember[]
  permissions RolePermissions[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("member_role")
}

model Permission {
  id        Int @id @default(autoincrement())
  entity    PermissionsEntity
  setting   PermissionSetting 

  role RolePermissions[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entity, setting])
  @@map("project_permission")
}

model RolePermissions {
  permissionId Int
  roleId Int

  permission Permission @relation(fields: [permissionId], references: [id])
  role MemberRole @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
}

model ProjectInvite {
  id        Int    @id @default(autoincrement())
  email     String
  code      String
  projectId Int    @map("project_id")

  expiredAt DateTime

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("project_invite")
}

model Cashbox {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  balance     Decimal @default(0)

  settings CashboxSettings[]

  plans CashboxBudget[]

  projectId Int     @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([id, projectId])
  @@map("cashbox")
}

model CashboxBudget {
  id Int @id @default(autoincrement())

  title String?
  description String?

  cashboxId Int
  cashbox Cashbox @relation(fields: [cashboxId], references: [id], onDelete: Cascade)

  amount Decimal

  startDate DateTime
  endDate DateTime

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cashbox_budget")
}

model CashboxField {
  id    Int    @id @default(autoincrement())
  title String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id          Int     @id @default(autoincrement())
  amount      Decimal
  description String?

  type TransactionType

  tagId Int? @map("tag_id")
  tag TransactionTag? @relation(fields: [tagId], references: [id], onDelete: SetNull)

  authorId Int  @map("author_id")
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  cashboxId Int     @map("cashbox_id")
  cashbox   Cashbox @relation(fields: [cashboxId], references: [id], onDelete: Cascade)

  transferExpense Transfer? @relation(name: "TransferExpense") 
  transferIncome Transfer? @relation(name: "TransferIncome")
  cancelTransferExpense Transfer? @relation(name: "cancelTransferExpense") 
  cancelTransferIncome Transfer? @relation(name: "cancelTransferIncome")

  createdAt DateTime @default(now())

  @@index([id, cashboxId, tagId])
  @@map("transaction")
}

model TransactionTag {
  id    Int    @id @default(autoincrement())
  title String @unique

  transactions Transaction[]

  createdAt DateTime @default(now())

 @@index([title])
  @@map("transaction_tag")
}

model Transfer {
  id Int     @id @default(autoincrement())

  expenseId Int? @unique
  incomeId  Int? @unique

  cancelExpenseId Int? @unique
  cancelIncomeId  Int? @unique

  expense Transaction? @relation("TransferExpense", fields: [expenseId], references: [id])
  income  Transaction? @relation("TransferIncome", fields: [incomeId], references: [id])

  cancelExpense Transaction? @relation("cancelTransferExpense", fields: [cancelExpenseId], references: [id])
  cancelIncome  Transaction? @relation("cancelTransferIncome", fields: [cancelIncomeId], references: [id])

  createAt DateTime @default(now())
  cancelAt DateTime?

  @@index([incomeId, expenseId])
  @@map("transfer")
}

model SettingGroup {
  id          Int    @id @default(autoincrement())
  code        String
  title       String
  description String

  target SettingTarget

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  settingDefinitions SettingDefinition[]

  @@map("setting_group")
}

model SettingDefinition {
  id   Int         @id @default(autoincrement())
  code String      @unique
  type SettingType

  title       String
  description String?

  projects ProjectSettings[]
  cashboxes CashboxSettings[]

  values Json?
  value  Json?

  target SettingTarget

  isRequired Boolean @default(false)
  isDisabled Boolean @default(false)
  isTelegram Boolean @default(false)

  groupId Int?
  group   SettingGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, target])
  @@map("setting")
}

model ProjectSettings {
  projectId Int
  settingId Int

  value Json?

  project Project @relation(fields: [projectId], references: [id])
  setting SettingDefinition @relation(fields: [settingId], references: [id])

  @@id([projectId, settingId])
}

model CashboxSettings {
  cashboxId Int
  settingId Int

  value Json?

  cashbox Cashbox @relation(fields: [cashboxId], references: [id])
  setting SettingDefinition @relation(fields: [settingId], references: [id])

  @@id([cashboxId, settingId])
}