model Cashbox {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  balance     Decimal @default(0)

  settings Json? @default("[]")

  projectId Int     @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  linkAsParent CashboxLink[] @relation("parent")
  linkAsChild  CashboxLink[] @relation("children")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([id, projectId])
  @@map("cashbox")
}

model CashboxLink {
  id Int @id @default(autoincrement())

  parentId   Int
  childrenId Int

  parent   Cashbox @relation(fields: [parentId], references: [id], onDelete: Cascade, name: "parent")
  children Cashbox @relation(fields: [childrenId], references: [id], onDelete: Cascade, name: "children")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, childrenId])
  @@map("cashbox_link")
}


model CashboxField {
  id    Int    @id @default(autoincrement())
  title String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
